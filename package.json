{
  "name": "audryo",
  "version": "0.1.1",
  "description": "CLI, MCP server and agent skills for the Audryo lifecycle email API.",
  "type": "module",
  "bin": {
    "audryo": "bin/audryo.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "LICENSE",
    "README.md",
    "server.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "mcp": "node ./bin/audryo.js mcp",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm test",
    "version-packages": "changeset version && node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Audryo",
  "homepage": "https://github.com/Audryo/agent-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Audryo/agent-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Audryo/agent-toolkit/issues"
  },
  "keywords": [
    "agent-skills",
    "audryo",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "email",
    "lifecycle",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.audryo/audryo",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}
